<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Aucune sauvegarde ni transfert des données (voir `res/xml/data_extraction_rules.xml`) :
         Google ne doit rien recevoir de ce que l'application garde sur le téléphone. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Liens de position venus d'une autre application (`app/src/services/incoming.ts`) :
                 « Itinéraire » d'un site, adresse d'un message ou d'un contact. Android propose
                 alors MY OSM, et « Toujours » en fait l'application par défaut. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="google.navigation" />
            </intent-filter>

            <!-- Liens web de cartes. Android ne les confie à une application non vérifiée pour
                 ces domaines que si l'utilisateur l'autorise (Paramètres › Applications › MY OSM ›
                 Ouvrir par défaut) ; Google Maps, s'il est installé, reste prioritaire. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="maps.google.com" />
                <data android:host="maps.apple.com" />
                <data android:host="www.openstreetmap.org" />
                <data android:host="openstreetmap.org" />
                <data android:host="osm.org" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.google.com" />
                <data android:host="www.google.fr" />
                <data android:pathPrefix="/maps" />
            </intent-filter>

            <!-- Autres liens de cartes que `parseMapLink` sait lire (Waze, Bing, HERE). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="waze.com" />
                <data android:host="www.waze.com" />
                <data android:host="ul.waze.com" />
                <data android:host="wego.here.com" />
                <data android:host="share.here.com" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="www.bing.com" />
                <data android:host="bing.com" />
                <data android:pathPrefix="/maps" />
            </intent-filter>

            <!-- Fichiers de traces et de points (`app/src/services/geoFile.ts`) : GPX, KML,
                 GeoJSON, ouverts depuis un gestionnaire de fichiers ou partagés par une autre
                 application. Lus par `MainActivity`. Par leur type quand l'expéditeur le
                 donne ; sinon par leur extension, que seul un nom de fichier porte. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:mimeType="application/gpx+xml" />
                <data android:mimeType="application/gpx" />
                <data android:mimeType="application/vnd.google-earth.kml+xml" />
                <data android:mimeType="application/geo+json" />
                <data android:mimeType="application/vnd.geo+json" />
            </intent-filter>
            <!-- Sans type ni nom : WhatsApp envoie un GPX en `application/octet-stream`, à une
                 adresse sans extension (`content://com.whatsapp.provider.media/item/…`, relevé
                 le 15 octobre 2026). Comme OsmAnd, MY OSM accepte tout fichier binaire ou XML et
                 en juge au contenu : ce qui n'est pas une carte s'annonce illisible. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="text/xml" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.gpx" />
                <data android:pathPattern=".*\\..*\\.gpx" />
                <data android:pathPattern=".*\\.kml" />
                <data android:pathPattern=".*\\..*\\.kml" />
                <data android:pathPattern=".*\\.geojson" />
                <data android:pathPattern=".*\\..*\\.geojson" />
            </intent-filter>

            <!-- Texte partagé (« Partager » › MY OSM) : réécrit en adresse par `MainActivity`. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

        </activity>

        <!-- Musique en cours pendant le guidage (`NowPlayingPlugin`) : Android ne
             montre les lecteurs actifs qu'aux applications dont un service
             d'écoute des notifications a été autorisé. Le service est vide et
             ne lit aucune notification ; la permission `BIND_…` garantit que
             seul le système peut s'y lier. -->
        <service
            android:name=".MediaNotificationListener"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- L'alerte de descente des transports (`GetOffAlertPlugin`) : l'alarme
             programmée arrive ici, écran éteint, et fait vibrer. Seul le système
             l'envoie (`exported="false"`). -->
        <receiver android:name=".GetOffAlertReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
        <!-- La WebView n'envoie rien à Google : ni statistiques d'usage et de plantage,
             ni adresses à faire vérifier par Safe Browsing. L'application ne charge que
             son propre code et des services connus (OSM, TomTom, services publics). -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
    </application>

    <!-- Annonces vocales du guidage (`SpeechPlugin`) : depuis Android 11, une
         application ne voit le moteur de synthèse vocale du téléphone que si
         elle déclare vouloir s'y lier. Aucune permission n'en découle. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Géolocalisation : le guidage en a besoin en continu. `COARSE` est
         exigée à côté de `FINE` depuis Android 12, sans quoi le système ne
         propose que la position approchée. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Alerte de descente (`GetOffAlertPlugin`) : vibrer, prévenir, et tenir
         l'heure même téléphone endormi. `SCHEDULE_EXACT_ALARM` s'accorde dans
         « Alarmes et rappels » ; sans elle, l'alerte peut arriver en retard. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
</manifest>
